# ==================== TradePilot 环境变量配置 ====================
# 复制此文件为 .env 并修改为实际值

# ------------------- 数据库配置 -------------------
POSTGRES_USER=tradepilot
POSTGRES_PASSWORD=tradepilot
POSTGRES_DB=tradepilot

# ------------------- 应用配置 -------------------
# JWT 密钥（生产环境必须更改）
JWT_SECRET=tradepilot-secret-change-in-production

# 时区
TZ=Asia/Shanghai

# ------------------- 服务端口配置 -------------------
# 前端端口
FRONTEND_PORT=3000
# 后端端口
BACKEND_PORT=8080
# Python 服务端口（内部，不对外暴露）
PYTHON_PORT=8081

# ------------------- 数据源配置 -------------------
# 数据源类型: tencent, eastmoney, sina
DATA_SOURCE_TYPE=tencent

# ------------------- LLM 配置（可选）-------------------
# LLM API 地址
# LLM_BASE_URL=http://localhost:11434
# LLM_API_KEY=your-api-key
# LLM_MODEL=qwen2.5:7b

# ------------------- OCR 配置（可选）-------------------
# OCR 服务地址
# OCR_BASE_URL=http://192.168.5.144:8888
